{
  "manifest_version": 3,
  "name": "PornHub Downloader",
  "version": "0.9.0",
  "description": "Save PornHub videos as MP4 files directly from your browser.",
  "minimum_chrome_version": "148",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "message_serialization": "structured_clone",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "permissions": ["downloads", "offscreen", "storage"],
  "host_permissions": [
    "https://*.pornhub.com/*",
    "https://*.phncdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.pornhub.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/ffmpeg-core.js",
        "vendor/ffmpeg-core.wasm",
        "vendor/worker.js",
        "vendor/const.js",
        "vendor/errors.js"
      ],
      "matches": ["https://*.pornhub.com/*"]
    }
  ]
}
